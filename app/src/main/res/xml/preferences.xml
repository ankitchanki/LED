<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <PreferenceCategory app:title="Look" app:iconSpaceReserved="false">
        <ListPreference
            app:key="style"
            app:title="Animation"
            app:defaultValue="pulse"
            app:entries="@array/style_names"
            app:entryValues="@array/style_values"
            app:useSimpleSummaryProvider="true"
            app:iconSpaceReserved="false" />
        <ListPreference
            app:key="multi_mode"
            app:title="Several notifications"
            app:defaultValue="cycle"
            app:entries="@array/multi_names"
            app:entryValues="@array/multi_values"
            app:useSimpleSummaryProvider="true"
            app:iconSpaceReserved="false" />
        <Preference
            app:key="default_color"
            app:title="Default colour"
            app:summary="Used when an app has no colour of its own"
            app:iconSpaceReserved="false" />
        <SwitchPreferenceCompat
            app:key="use_notif_color"
            app:title="Use the app's notification colour"
            app:defaultValue="true"
            app:iconSpaceReserved="false" />
        <SwitchPreferenceCompat
            app:key="use_icon_color"
            app:title="Use the app icon's colour"
            app:summary="When the notification has no accent colour"
            app:defaultValue="true"
            app:iconSpaceReserved="false" />
        <SeekBarPreference
            app:key="speed"
            app:title="Animation speed"
            app:defaultValue="5"
            app:min="1"
            android:max="10"
            app:showSeekBarValue="true"
            app:iconSpaceReserved="false" />
        <SeekBarPreference
            app:key="led_alpha"
            app:title="Light intensity (%)"
            app:defaultValue="100"
            app:min="10"
            android:max="100"
            app:showSeekBarValue="true"
            app:iconSpaceReserved="false" />
        <SwitchPreferenceCompat
            app:key="glow"
            app:title="Soft glow"
            app:summary="Slightly more GPU work; turn off for maximum battery"
            app:defaultValue="true"
            app:iconSpaceReserved="false" />
        <SeekBarPreference
            app:key="edge_radius"
            app:title="Edge lighting corner radius (dp)"
            app:summary="Android 12+ uses the real screen corners automatically"
            app:defaultValue="40"
            app:min="0"
            android:max="120"
            app:showSeekBarValue="true"
            app:iconSpaceReserved="false" />
        <Preference
            app:key="open_cutout"
            app:title="Camera position &amp; ring size"
            app:summary="Auto-detect or fine-tune around your punch-hole / notch"
            app:iconSpaceReserved="false" />
    </PreferenceCategory>

    <PreferenceCategory app:title="Screen off (always-on light)" app:iconSpaceReserved="false">
        <SwitchPreferenceCompat
            app:key="aod_enabled"
            app:title="Show the light while the screen is off"
            app:summary="Black screen; on AMOLED only the light's pixels use power"
            app:defaultValue="true"
            app:iconSpaceReserved="false" />
        <SwitchPreferenceCompat
            app:key="aod_on_screen_off"
            app:dependency="aod_enabled"
            app:title="When I turn the screen off"
            app:summary="If unread notifications are waiting"
            app:defaultValue="true"
            app:iconSpaceReserved="false" />
        <SwitchPreferenceCompat
            app:key="aod_on_new"
            app:dependency="aod_enabled"
            app:title="When a new notification arrives"
            app:defaultValue="true"
            app:iconSpaceReserved="false" />
        <ListPreference
            app:key="aod_timeout"
            app:dependency="aod_enabled"
            app:title="Keep the light on for"
            app:defaultValue="120"
            app:entries="@array/timeout_names"
            app:entryValues="@array/timeout_values"
            app:useSimpleSummaryProvider="true"
            app:iconSpaceReserved="false" />
        <ListPreference
            app:key="pulse_interval"
            app:dependency="aod_enabled"
            app:title="Remind me afterwards"
            app:defaultValue="0"
            app:entries="@array/pulse_names"
            app:entryValues="@array/pulse_values"
            app:useSimpleSummaryProvider="true"
            app:iconSpaceReserved="false" />
        <SeekBarPreference
            app:key="pulse_duration"
            app:dependency="aod_enabled"
            app:title="Reminder length (seconds)"
            app:defaultValue="10"
            app:min="3"
            android:max="60"
            app:showSeekBarValue="true"
            app:iconSpaceReserved="false" />
        <SeekBarPreference
            app:key="aod_brightness"
            app:dependency="aod_enabled"
            app:title="Screen brightness (%)"
            app:summary="Lower is better for battery"
            app:defaultValue="3"
            app:min="1"
            android:max="100"
            app:showSeekBarValue="true"
            app:iconSpaceReserved="false" />
        <SwitchPreferenceCompat
            app:key="proximity"
            app:dependency="aod_enabled"
            app:title="Pocket detection"
            app:summary="Hide when covered; stop after 10 s in a pocket or face down"
            app:defaultValue="true"
            app:iconSpaceReserved="false" />
        <SwitchPreferenceCompat
            app:key="tap_dismiss"
            app:dependency="aod_enabled"
            app:title="Tap to show the lock screen"
            app:defaultValue="true"
            app:iconSpaceReserved="false" />
        <SwitchPreferenceCompat
            app:key="double_tap_off"
            app:dependency="aod_enabled"
            app:title="Double-tap to turn the screen off"
            app:defaultValue="true"
            app:iconSpaceReserved="false" />
        <SwitchPreferenceCompat
            app:key="burn_in"
            app:dependency="aod_enabled"
            app:title="Burn-in protection"
            app:summary="Shifts the light by a few pixels every minute"
            app:defaultValue="true"
            app:iconSpaceReserved="false" />
    </PreferenceCategory>

    <PreferenceCategory app:title="Screen on" app:iconSpaceReserved="false">
        <SwitchPreferenceCompat
            app:key="overlay_enabled"
            app:title="Show the light while the screen is on"
            app:defaultValue="true"
            app:iconSpaceReserved="false" />
        <SwitchPreferenceCompat
            app:key="overlay_lock_only"
            app:dependency="overlay_enabled"
            app:title="Only on the lock screen"
            app:defaultValue="false"
            app:iconSpaceReserved="false" />
    </PreferenceCategory>

    <PreferenceCategory app:title="Which notifications" app:iconSpaceReserved="false">
        <ListPreference
            app:key="app_mode"
            app:title="Apps"
            app:defaultValue="all"
            app:entries="@array/app_mode_names"
            app:entryValues="@array/app_mode_values"
            app:useSimpleSummaryProvider="true"
            app:iconSpaceReserved="false" />
        <Preference
            app:key="open_apps"
            app:title="Per-app on/off &amp; colours"
            app:iconSpaceReserved="false" />
        <SwitchPreferenceCompat
            app:key="ignore_low"
            app:title="Ignore silent notifications"
            app:defaultValue="true"
            app:iconSpaceReserved="false" />
        <SwitchPreferenceCompat
            app:key="respect_dnd"
            app:title="Respect Do Not Disturb"
            app:defaultValue="true"
            app:iconSpaceReserved="false" />
        <SwitchPreferenceCompat
            app:key="clear_on_unlock"
            app:title="Clear the light after I unlock"
            app:summary="Off: the light stays until the notification is dismissed"
            app:defaultValue="false"
            app:iconSpaceReserved="false" />
    </PreferenceCategory>

    <PreferenceCategory app:title="Battery" app:iconSpaceReserved="false">
        <ListPreference
            app:key="fps_cap"
            app:title="Animation frame rate"
            app:defaultValue="30"
            app:entries="@array/fps_names"
            app:entryValues="@array/fps_values"
            app:useSimpleSummaryProvider="true"
            app:iconSpaceReserved="false" />
        <SwitchPreferenceCompat
            app:key="low_refresh"
            app:title="Lowest refresh rate while screen is off"
            app:summary="Big saving on 90/120 Hz screens"
            app:defaultValue="true"
            app:iconSpaceReserved="false" />
        <SeekBarPreference
            app:key="min_battery"
            app:title="Pause below battery (%)"
            app:summary="Ignored while charging"
            app:defaultValue="10"
            app:min="0"
            android:max="50"
            app:showSeekBarValue="true"
            app:iconSpaceReserved="false" />
        <SwitchPreferenceCompat
            app:key="quiet_enabled"
            app:title="Quiet hours"
            app:summary="No always-on light at night"
            app:defaultValue="false"
            app:iconSpaceReserved="false" />
        <Preference
            app:key="quiet_start"
            app:dependency="quiet_enabled"
            app:title="Quiet hours start"
            app:iconSpaceReserved="false" />
        <Preference
            app:key="quiet_end"
            app:dependency="quiet_enabled"
            app:title="Quiet hours end"
            app:iconSpaceReserved="false" />
    </PreferenceCategory>

    <PreferenceCategory app:title="About" app:iconSpaceReserved="false">
        <Preference
            app:key="version"
            app:title="Version"
            app:iconSpaceReserved="false" />
    </PreferenceCategory>
</PreferenceScreen>
