<?xml version="1.0" encoding="utf-8"?>
<!-- Compact single screen: header, swipeable sections, thumb dock. Pull down for one-handed mode. -->
<com.glowled.app.view.ReachLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:orientation="vertical">
    <!-- Background: GlassBackdrop (soft colour glows behind the frosted cards), set in code. -->

    <!-- Header: sits under the transparent status bar (top inset added in code). -->
    <LinearLayout
        android:id="@+id/header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="20dp"
        android:paddingTop="8dp"
        android:paddingBottom="4dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/app_name"
                android:textAppearance="?attr/textAppearanceHeadlineSmall"
                android:textColor="@color/text_primary"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textAppearance="?attr/textAppearanceBodySmall"
                android:textColor="@color/text_secondary" />
        </LinearLayout>

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/master"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:contentDescription="@string/master_on" />
    </LinearLayout>

    <!-- One-handed mode: grows when you pull the settings down, pushing them into thumb reach. -->
    <LinearLayout
        android:id="@+id/reachSpace"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:alpha="0"
        android:gravity="bottom|center_horizontal"
        android:orientation="vertical"
        android:paddingBottom="12dp">

        <!-- Live preview of the screen-off light (filled in code), updates as settings change. -->
        <FrameLayout
            android:id="@+id/reachPreview"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginHorizontal="24dp"
            android:layout_marginTop="8dp" />

        <TextView
            android:id="@+id/reachHint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center"
            android:text="@string/reach_hint"
            android:textAppearance="?attr/textAppearanceBodySmall"
            android:textColor="@color/text_secondary" />
    </LinearLayout>

    <com.google.android.material.tabs.TabLayout
        android:id="@+id/tabs"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:background="@android:color/transparent"
        app:tabGravity="start"
        app:tabIndicator="@drawable/tab_indicator"
        app:tabIndicatorColor="@color/accent"
        app:tabIndicatorFullWidth="false"
        app:tabIndicatorHeight="3dp"
        app:tabMode="scrollable"
        app:tabPaddingEnd="14dp"
        app:tabPaddingStart="14dp"
        app:tabRippleColor="@color/accent_dim"
        app:tabSelectedTextColor="@color/accent"
        app:tabTextAppearance="?attr/textAppearanceTitleSmall"
        app:tabTextColor="@color/text_secondary" />

    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/pager"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- Floating Test pill; swipe down anywhere at the top of a page for live preview. -->
    <LinearLayout
        android:id="@+id/dock"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@android:color/transparent"
        android:orientation="horizontal"
        android:gravity="center"
        android:paddingHorizontal="16dp"
        android:paddingTop="8dp"
        android:paddingBottom="10dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnTest"
            style="@style/GlowDockButton"
            android:layout_width="wrap_content"
            android:layout_height="56dp"
            android:minWidth="168dp"
            android:elevation="8dp"
            android:layout_marginVertical="8dp"
            android:text="@string/action_test_short"
            app:backgroundTint="@color/accent"
            android:textColor="@color/black"
            app:iconTint="@color/black"
            app:icon="@drawable/ic_bell" />
    </LinearLayout>
</com.glowled.app.view.ReachLayout>
