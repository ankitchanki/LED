<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.GlowLED" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/accent</item>
        <item name="colorOnPrimary">@color/black</item>
        <item name="colorPrimaryContainer">@color/accent_dim</item>
        <item name="colorOnPrimaryContainer">@color/accent</item>
        <item name="colorSecondary">@color/accent</item>
        <item name="colorOnSecondary">@color/black</item>
        <item name="colorSecondaryContainer">@color/surface_high</item>
        <item name="colorOnSecondaryContainer">@color/text_primary</item>
        <item name="colorTertiary">@color/accent</item>
        <item name="colorSurfaceVariant">@color/surface_high</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="colorOnSurfaceVariant">@color/text_secondary</item>
        <item name="colorSurfaceContainerHighest">@color/outline</item>
        <!-- Dialogs, menus and pickers draw on these: keep them readable (not see-through). -->
        <item name="colorSurface">@color/dialog_surface</item>
        <item name="colorSurfaceContainer">@color/dialog_surface</item>
        <item name="colorSurfaceContainerHigh">@color/dialog_surface</item>
        <item name="colorSurfaceContainerLow">@color/dialog_surface</item>
        <item name="colorOutline">@color/outline</item>
        <item name="android:colorBackground">@color/background</item>
        <item name="android:windowBackground">@color/background</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:enforceNavigationBarContrast">false</item>
        <item name="android:enforceStatusBarContrast">false</item>
        <item name="android:windowLightStatusBar">@bool/light_bars</item>
        <item name="android:windowLightNavigationBar">@bool/light_bars</item>
        <item name="materialCardViewStyle">@style/GlowCard</item>
        <item name="shapeAppearanceCornerLarge">@style/GlowShapeLarge</item>
        <item name="materialAlertDialogTheme">@style/ThemeOverlay.GlowLED.Dialog</item>
    </style>

    <!-- Frosted dialogs: blur behind is added on Android 12+ (values-v31). -->
    <style name="ThemeOverlay.GlowLED.Dialog" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="colorSurface">@color/dialog_surface</item>
        <item name="colorSurfaceContainerHigh">@color/dialog_surface</item>
        <item name="android:backgroundDimAmount">0.35</item>
    </style>

    <style name="GlowCard" parent="Widget.Material3.CardView.Filled">
        <item name="cardBackgroundColor">@color/surface</item>
        <item name="cardCornerRadius">24dp</item>
        <item name="strokeWidth">1dp</item>
        <item name="strokeColor">@color/glass_stroke</item>
    </style>

    <style name="GlowShapeLarge" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">24dp</item>
    </style>

    <!-- Floating Test pill: small, see-through (iOS-style), so it never hides the settings. -->
    <style name="GlowTabText" parent="TextAppearance.Material3.TitleSmall">
        <item name="android:textSize">15sp</item>
        <item name="textAllCaps">false</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <style name="GlowPill" parent="Widget.Material3.Button.TonalButton.Icon">
        <item name="backgroundTint">@color/pill_bg</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="iconTint">@color/accent</item>
        <item name="iconGravity">textStart</item>
        <item name="iconSize">18dp</item>
        <item name="cornerRadius">@dimen/pill_radius</item>
        <item name="android:textAppearance">?attr/textAppearanceLabelLarge</item>
        <item name="strokeColor">@color/glass_stroke</item>
        <item name="strokeWidth">1dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:paddingStart">18dp</item>
        <item name="android:paddingEnd">22dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:elevation">6dp</item>
    </style>

    <style name="GlowHeaderTitle.Expanded" parent="TextAppearance.Material3.DisplaySmall">
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="GlowHeaderTitle.Collapsed" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="Theme.GlowLED.Fullscreen" parent="Theme.Material3.Dark.NoActionBar">
        <item name="colorPrimary">@color/accent</item>
        <item name="colorOnPrimary">@color/black</item>
        <item name="android:windowBackground">@color/black</item>
        <item name="android:statusBarColor">@color/black</item>
        <item name="android:navigationBarColor">@color/black</item>
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
    </style>

    <!-- Quick-reply sheet: transparent window, the activity draws its own dim and sheet. -->
    <style name="Theme.GlowLED.Reply" parent="Theme.GlowLED">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowAnimationStyle">@null</item>
    </style>

    <!-- Plain platform theme: the AOD screen loads as fast as possible with no preview flash. -->
    <style name="Theme.GlowLED.Aod" parent="android:Theme.DeviceDefault.NoActionBar.Fullscreen">
        <!-- Preserve literal black in dark mode, including the window's starting frame. -->
        <item name="android:forceDarkAllowed">false</item>
        <item name="android:windowBackground">@color/black</item>
        <item name="android:colorBackground">@color/black</item>
        <item name="android:windowAnimationStyle">@null</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
        <item name="android:windowIsTranslucent">false</item>
        <item name="android:backgroundDimEnabled">false</item>
        <item name="android:enforceStatusBarContrast">false</item>
        <item name="android:enforceNavigationBarContrast">false</item>
        <item name="android:statusBarColor">@color/black</item>
        <item name="android:navigationBarColor">@color/black</item>
    </style>
</resources>
