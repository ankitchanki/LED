    <string name="perm_listener">Notification access</string>
    <string name="perm_listener_desc">Required. Lets Glow LED know when a notification arrives. Nothing leaves your phone.</string>
    <string name="perm_a11y">Accessibility (optional, most reliable)</string>
    <string name="perm_a11y_desc">Not required. Adds: instant screen-off after the light times out, and a light that no phone brand can block. Skip it if you prefer.</string>
    <string name="perm_overlay">Display over other apps</string>
    <string name="perm_overlay_desc">Lets the light appear when the screen is off. Enough on its own - no Accessibility needed.</string>
    <string name="perm_post">Notifications</string>
    <string name="perm_post_desc">Needed for the test notification and the fallback launcher.</string>
    <string name="perm_battery">Unrestricted battery</string>
    <string name="perm_battery_desc">Stops the system from killing Glow LED. The app itself uses almost no power in the background.</string>
    <string name="perm_oem">Autostart (%s)</string>
    <string name="perm_oem_desc">Your phone brand has an extra app killer. Allow Glow LED to autostart and run in the background.</string>
    <string name="perm_miui">Xiaomi lock-screen permissions</string>
    <string name="perm_miui_desc">HyperOS/MIUI: turn on \"Show on lock screen\" and \"Display pop-up windows while running in background\".</string>
    <string name="restricted_hint">Android 13+: apps installed from an APK file get \"restricted settings\" for Notification access and Accessibility. This is an Android rule, not a bug. If a switch is greyed out: App info → ⋮ (top right) → Allow restricted settings, then try again.</string>
