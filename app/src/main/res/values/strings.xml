    <string name="setup_title">Setup</string>
    <string name="perm_listener">Notification access</string>
    <string name="perm_listener_desc">Required. Lets Glow LED know when a notification arrives. Nothing leaves your phone.</string>
    <string name="perm_a11y">Accessibility overlay</string>
    <string name="perm_a11y_desc">Recommended. Shows the light on the lock screen, wakes the always-on screen and turns it off again.</string>
    <string name="perm_overlay">Display over other apps</string>
    <string name="perm_overlay_desc">Alternative to accessibility. Works while unlocked; not over the lock screen on every phone.</string>
    <string name="perm_post">Notifications</string>
    <string name="perm_post_desc">Needed for the test notification and the fallback launcher.</string>
    <string name="perm_battery">Unrestricted battery</string>
    <string name="perm_battery_desc">Stops the system from killing Glow LED. The app itself uses almost no power in the background.</string>
    <string name="perm_fsi">Full-screen alerts</string>
    <string name="perm_fsi_desc">Fallback way to wake the always-on screen when accessibility is off.</string>
    <string name="perm_oem">Autostart (%s)</string>
    <string name="perm_oem_desc">Your phone brand has an extra app killer. Allow Glow LED to autostart and run in the background.</string>
